{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "excludeFiles": "{episode_mock.mp4,.env*,.data/**,tests/**,test-results/**,playwright-report/**,.npm-cache/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/media/:path*", "destination": "/api/index" }
  ]
}
