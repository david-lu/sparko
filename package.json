{
  "name": "sparko-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "comfy:check": "tsx scripts/check-comfy.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "vercel:upload-default": "node scripts/upload-default.mjs",
    "vercel:upload-sample": "tsx scripts/upload-sample.ts",
    "deploy:preview": "npx vercel",
    "deploy:production": "npx vercel --prod"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.30.0",
    "@mediabunny/aac-encoder": "^1.61.5",
    "@ricky0123/vad-web": "^0.0.31",
    "@vercel/blob": "^2.8.2",
    "@zip.js/zip.js": "^2.24.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.58.0",
    "mediabunny": "^1.61.5",
    "multer": "^2.4.0",
    "openai": "^7.34.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  }
}
